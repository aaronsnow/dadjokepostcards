# Your deployed backend's URL (see ../backend). Leave unset to use the
# temporary public demo proxy for jokes instead — fine for poking around
# locally, not for real users.
VITE_API_BASE=https://your-backend.onrender.com

# Stripe's PUBLISHABLE key (safe for client-side code — this is not the
# secret key). Dashboard → Developers → API keys → Publishable key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Should match the backend's ENVIRONMENT_NAME for this same environment
# (e.g. "local", "staging", or "production"). Used only to decide whether
# the payment screen shows test-card instructions — set it exactly to
# "production" for the real production deploy, anything else shows the
# test-mode banner.
VITE_ENVIRONMENT_NAME=local

# Your GoatCounter site code (the subdomain — e.g. "dadjokepostcards" for
# dadjokepostcards.goatcounter.com). Set this ONLY on your real production
# deploy. Leave it unset everywhere else (staging, local dev, and any
# fork of this repo) — Vite just leaves the %VITE_GOATCOUNTER_CODE%
# placeholder in index.html unreplaced when it's unset, which points at a
# nonexistent GoatCounter site and fails harmlessly. That's a deliberate
# second layer of protection on top of ANALYTICS_ENABLED in App.jsx: if
# that check ever had a bug, there'd still be no real site code for it to
# accidentally report to.
VITE_GOATCOUNTER_CODE=dadjokepostcards

# The full public URL this specific environment is served at — used to
# build the canonical link, Open Graph/Twitter Card URLs, and the
# meta-robots directive in index.html, so social-preview links and search
# indexing point at the right domain per environment (production vs.
# staging) instead of one hardcoded value everywhere.
#
# ⚠️ Unlike VITE_GOATCOUNTER_CODE above, an unset VITE_SITE_URL does NOT
# fail harmlessly — `vite build` (what runs on every real deploy, including
# via `vite preview` on Railway) throws a hard "URI malformed" error and
# refuses to build at all if this placeholder is left unresolved. Plain
# `npm run dev` locally tolerates it fine (just a console warning, broken
# meta tag content) since it doesn't go through the same build step — but
# every deployed environment (staging, production) MUST have this set, or
# the deploy will fail outright.
VITE_SITE_URL=https://your-domain.example.com

# Same "required in every deployed environment, optional-ish locally"
# caveat as VITE_SITE_URL above. Controls the <meta name="robots"> tag —
# use "index, follow" for production (so search engines index it) and
# "noindex, nofollow" for staging or any preview environment (so it never
# shows up in search results as duplicate content).
VITE_ROBOTS=index, follow

# Local-dev-only convenience — leave unset everywhere else. When set to
# any truthy value, "Next joke" requests a guaranteed-long joke (via the
# backend's local-only /api/joke?long=1 helper — see backend/.env.example)
# instead of one random one, for testing the print-overflow fix without
# needing to click repeatedly and hope. The backend independently refuses
# to honor this outside local dev regardless of what's sent, so leaving
# this set by accident in a deployed environment wouldn't do anything —
# but there's no reason to rely on that as the only safeguard.
VITE_TEST_LONG_JOKES=
