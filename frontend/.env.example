# Your deployed backend's URL (see ../backend). Leave unset to use the
# temporary public demo proxy for jokes instead — fine for poking around
# locally, not for real users.
VITE_API_BASE=https://your-backend.onrender.com

# Stripe's PUBLISHABLE key (safe for client-side code — this is not the
# secret key). Dashboard → Developers → API keys → Publishable key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Should match the backend's ENVIRONMENT_NAME for this same environment
# (e.g. "local", "staging", or "production"). Used only to decide whether
# the payment screen shows test-card instructions — set it exactly to
# "production" for the real production deploy, anything else shows the
# test-mode banner.
VITE_ENVIRONMENT_NAME=local
