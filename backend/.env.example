# Stripe (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...
# For LOCAL testing: run `stripe listen --forward-to localhost:3001/api/stripe-webhook`
# in its own terminal — it prints a webhook signing secret (whsec_...) to use here.
# For a DEPLOYED backend: Dashboard > Developers > Webhooks > add your live endpoint,
# then use the signing secret it gives you instead.
STRIPE_WEBHOOK_SECRET=whsec_...

# Lob (Dashboard > Settings > API Keys) — start with the test key (starts "test_")
LOB_API_KEY=test_...

# Your return address — required on every postcard by USPS
RETURN_ADDRESS_NAME="Pun & Post"
RETURN_ADDRESS_LINE1="123 Main St"
RETURN_ADDRESS_CITY="Kensington"
RETURN_ADDRESS_STATE="MD"
RETURN_ADDRESS_ZIP="20895"

# Where your frontend is hosted, for CORS. Accepts a comma-separated list
# if you want more than one origin allowed at once, e.g. your custom domain
# plus Railway's auto-generated URL:
# FRONTEND_ORIGIN=https://www.dadjokepostcards.com,https://dadjokepostcards.up.railway.app
FRONTEND_ORIGIN=https://yourapp.example.com

# IMPORTANT: must be a DIFFERENT value in each environment — production,
# staging, and your local machine should each use a distinct value here
# (e.g. "production", "staging", "local"). Stripe delivers every test-mode
# webhook event to every registered test-mode destination, so without this,
# production/staging/local will all try to process the same purchase and
# each send their own postcard for it.
ENVIRONMENT_NAME=local

# Price per postcard, in cents. Change this any time in Railway's Variables
# tab (no code change or redeploy needed — Railway restarts the service
# automatically when a variable changes) to update the price everywhere at
# once, since the frontend fetches this from the backend rather than
# hardcoding its own copy.
PRICE_CENTS=499

PORT=3001
