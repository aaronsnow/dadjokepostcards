# Stripe (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...
# Stripe (Dashboard > Developers > Webhooks, after you add the endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Lob (Dashboard > Settings > API Keys) — start with the test key (starts "test_")
LOB_API_KEY=test_...

# Your return address — required on every postcard by USPS
RETURN_ADDRESS_NAME="Pun & Post"
RETURN_ADDRESS_LINE1="123 Main St"
RETURN_ADDRESS_CITY="Kensington"
RETURN_ADDRESS_STATE="MD"
RETURN_ADDRESS_ZIP="20895"

# Where your frontend is hosted, for CORS
FRONTEND_ORIGIN=https://yourapp.example.com

PORT=3001
